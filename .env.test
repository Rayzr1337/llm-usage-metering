# Test environment. Used by tests/helpers/setup.ts via dotenv.
# The test runner MUST point DATABASE_URL at a separate database (e.g. metering_test),
# never at the dev database. See tests/README.md.
DATABASE_URL="postgres://postgres:dev@localhost:5432/metering_test"
APP_URL="http://localhost:4750"

# A fixed webhook secret so we can build valid signatures offline with
# Stripe.webhooks.generateTestHeaderString() — no network calls needed.
STRIPE_WEBHOOK_SECRET="whsec_test_secret_for_jest_suite_only"
STRIPE_TEST_KEY="sk_test_dummy_key_for_module_instantiation_only"
STRIPE_PRO_PRICE_ID="price_test_dummy"

# REDIS_URL is intentionally left unset; the suite asserts the app behaves
# correctly with Redis disconnected (redisClient.isOpen === false).